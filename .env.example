# Required for a deployed dashboard
NODE_ENV=production
BASE_URL=https://your-weekly-pull-list.onrender.com
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
PIN_HASH=generated-by-npm-run-pin

# Turso (leave unset for a LOCAL file database only)
TURSO_DATABASE_URL=libsql://your-db-your-account.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-token

# Gmail account used by Daily News Digest (configure when ready)
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_TO=
EMAIL_FROM=Your Weekly Pull List

# Optional: comma-separated HTTPS hostnames serving PDFs you own or are allowed to distribute
AUTHORIZED_PDF_HOSTS=
# Set to true to prevent link-only deliveries when PDFs are missing
REQUIRE_PDF_ATTACHMENTS=false

PORT=3000

# Only for the optional Windows-side authorized PDF inbox
# PDF_INBOX_DIR=C:\\Users\\YOUR_USER\\Downloads\\WeeklyPullList
PDF_WATCH_SECONDS=30
