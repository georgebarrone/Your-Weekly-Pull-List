{
  "name": "your-weekly-pull-list",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal comic pull-list dashboard and weekly email digest",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "weekly": "node scripts/weekly.js",
    "pin": "node scripts/hash-pin.js",
    "test": "node --test tests/*.test.js",
    "pdf-inbox": "node scripts/pdf-inbox.js",
    "pdf-watch": "node scripts/pdf-inbox.js --watch",
    "pdf-login": "node scripts/pdf-login.js",
    "pdf-weekly": "node scripts/pdf-weekly.js",
    "pdf-diagnose": "node scripts/pdf-diagnose.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^7.0.0",
    "playwright": "^1.56.1"
  }
}
